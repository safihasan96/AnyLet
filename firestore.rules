rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ── Helper Functions ───────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }
    
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // ── Collection Rules ───────────────────────────────────────────────────
    
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      // Allow creation for new signups
      allow create: if isOwner(uid);
      allow update: if isOwner(uid) || isAdmin();
      allow delete: if isAdmin();
    }
    
    match /properties/{propertyId} {
      // Anyone can read approved properties
      allow read: if resource.data.isApproved == true || (isSignedIn() && resource.data.ownerId == request.auth.uid) || isAdmin();
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if (isSignedIn() && resource.data.ownerId == request.auth.uid) || isAdmin();
      allow delete: if isAdmin();
    }
    
    match /viewing_requests/{requestId} {
      allow read, update: if isSignedIn() && (resource.data.tenantId == request.auth.uid || resource.data.ownerId == request.auth.uid) || isAdmin();
      allow create: if isSignedIn() && request.resource.data.tenantId == request.auth.uid;
      allow delete: if isAdmin();
    }
    
    match /conversations/{conversationId} {
      allow read, update: if isSignedIn() && (request.auth.uid in resource.data.participants) || isAdmin();
      allow create: if isSignedIn() && (request.auth.uid in request.resource.data.participants);
      allow delete: if isAdmin();
      
      match /messages/{messageId} {
        // Must be participant in parent conversation
        allow read, create: if isSignedIn() && (request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants) || isAdmin();
        allow update, delete: if isAdmin();
      }
    }
    
    match /tenantMoveIns/{moveInId} {
      allow read, update: if isSignedIn() && (resource.data.tenantId == request.auth.uid || resource.data.ownerId == request.auth.uid) || isAdmin();
      allow create: if isSignedIn() && request.resource.data.tenantId == request.auth.uid;
      allow delete: if isAdmin();
    }
    
    match /paymentIntents/{intentId} {
      allow read: if isOwner(resource.data.uid) || isAdmin();
      // Writes are strictly restricted to the backend Admin SDK (api/create-payment-intent.js)
      allow write: if false; 
    }
    
    match /kycSubmissions/{submissionId} {
      allow read: if isOwner(resource.data.uid) || isAdmin();
      // Only the backend verify-kyc.js writes this directly
      allow write: if false;
    }
    
    match /withdrawals/{withdrawalId} {
      allow read: if isOwner(resource.data.uid) || isAdmin();
      allow write: if false; // Backend only
    }
    
    match /commissions/{commissionId} {
      allow read: if isOwner(resource.data.referrerId) || isAdmin();
      allow write: if false; // Backend only
    }
    
    match /adminAuditLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false; // Backend only
    }
    
    match /notifications/{notificationId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow update: if isOwner(resource.data.userId); // Allow marking as read
      allow create, delete: if isAdmin(); // Or backend only
    }
    
    match /escrowDeposits/{escrowId} {
      allow read: if isSignedIn() && (resource.data.tenantId == request.auth.uid || resource.data.ownerId == request.auth.uid) || isAdmin();
      allow write: if false; // Backend only
    }
    
    match /payments/{paymentId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow write: if false; // Backend only
    }

    match /reports/{reportId} {
      allow read: if isAdmin();
      allow create: if isSignedIn() && request.resource.data.reporterId == request.auth.uid;
      allow update, delete: if isAdmin();
    }
    
    match /enquiries/{enquiryId} {
      allow read, create: if isSignedIn() && request.resource.data.tenantId == request.auth.uid || isAdmin();
      allow update, delete: if isAdmin();
    }

    match /propertyReviews/{reviewId} {
      allow read: if true; // Public
      allow create: if isSignedIn() && request.resource.data.reviewerId == request.auth.uid;
      allow update, delete: if isAdmin() || (isSignedIn() && resource.data.reviewerId == request.auth.uid);
    }
    
    match /ownerReviews/{reviewId} {
      allow read: if true; // Public
      allow create: if isSignedIn() && request.resource.data.reviewerId == request.auth.uid;
      allow update, delete: if isAdmin() || (isSignedIn() && resource.data.reviewerId == request.auth.uid);
    }
  }
}
