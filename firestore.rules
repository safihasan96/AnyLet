rules_version = '2';

service cloud.firestore {

  match /databases/{database}/documents {

 

    // ── Helpers ────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }


    // ── Properties (public read, owner write) ──────────
    match /properties/{propertyId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn()
        && (isOwner(resource.data.ownerId) || isAdmin());
    }

 

    // ── Viewing Requests ───────────────────────────────

    // Only the owner OR the tenant of a request can read/write it

    match /viewing_requests/{requestId} {

      allow read: if isSignedIn()

        && (isOwner(resource.data.ownerId)

            || isOwner(resource.data.tenantId));

      allow create: if isSignedIn()

        && isOwner(request.resource.data.tenantId);

      allow update: if isSignedIn()

        && (isOwner(resource.data.ownerId)

            || isOwner(resource.data.tenantId));

      allow delete: if isSignedIn()

        && (isOwner(resource.data.ownerId)

            || isOwner(resource.data.tenantId));

    }

 

    // ── Conversations ──────────────────────────────────

    // Only participants can read/write

    match /conversations/{conversationId} {

      allow read, update: if isSignedIn()

        && request.auth.uid in resource.data.participants;

      allow create: if isSignedIn()

        && request.auth.uid in request.resource.data.participants;

 

      // Messages subcollection
      match /messages/{messageId} {
        allow read: if isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;

        allow create: if isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants
          && isOwner(request.resource.data.senderId);

        allow update: if isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
      }

    }

 

    // ── Notifications ──────────────────────────────────

    match /notifications/{notificationId} {

      allow read, write: if isSignedIn()

        && isOwner(resource.data.userId);

      allow create: if isSignedIn();

    }

 

    // ── Users (profile data) ───────────────────────────
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && (isOwner(userId) || isAdmin());
    }

 

    // ── Reviews ───────────────────────────────────────

    match /reviews/{reviewId} {

      allow read: if true;

      allow create: if isSignedIn();

      allow update, delete: if isSignedIn()

        && isOwner(resource.data.reviewerId);

    }

 

    // ── Payments ──────────────────────────────────────
    match /payments/{paymentId} {
      // Any signed-in user can create a payment record
      allow create: if isSignedIn()
        && isOwner(request.resource.data.userId);

      // User reads their own; admin reads all
      allow read: if isSignedIn()
        && (isOwner(resource.data.userId) || isAdmin());

      // Only admin can update (approve/reject)
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ── Escrow Deposits ────────────────────────────────
    match /escrowDeposits/{depositId} {
      allow create: if isSignedIn()
        && isOwner(request.resource.data.userId);

      allow read: if isSignedIn()
        && (isOwner(resource.data.userId) || isOwner(resource.data.ownerId) || isAdmin());

      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ── Enquiries ─────────────────────────────────────
    match /enquiries/{enquiryId} {
      allow create: if isSignedIn();
      allow read: if isSignedIn()
        && (isOwner(resource.data.userId) || isAdmin());
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ── Reports ───────────────────────────────────────
    match /reports/{reportId} {
      allow create: if isSignedIn();
      allow read: if isSignedIn()
        && (isOwner(resource.data.reportedBy) || isAdmin());
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ── SMS Incoming Audit Log ─────────────────────────
    // Written exclusively by the server-side Admin SDK (which bypasses rules).
    // No client — not even an admin user — can read or write this directly.
    match /smsIncoming/{txnId} {
      allow read, write: if false;
    }

    // ── Deny all other access ─────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }

  }

}
