rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow public read for properties and related data
    match /properties/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /listings/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /promotions/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Allow public access to OTP verifications for signup flow
    match /otp_verifications/{email} {
      allow read, write: if true;
    }

    // Tenant move-in records — tenant owns their own, public readable for owner profile
    match /tenantMoveIns/{docId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.tenantId == request.auth.uid;
      allow update: if request.auth != null && resource.data.tenantId == request.auth.uid;
      allow delete: if request.auth != null && resource.data.tenantId == request.auth.uid;
    }

    // Owner reviews — public read (approved only handled client-side), auth create
    match /ownerReviews/{docId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.reviewerId == request.auth.uid;
      allow update, delete: if request.auth != null &&
        (resource.data.reviewerId == request.auth.uid ||
         resource.data.ownerId == request.auth.uid || 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
    }

    // Property reviews — public read, auth create
    match /propertyReviews/{docId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.reviewerId == request.auth.uid;
      allow update, delete: if request.auth != null &&
        (resource.data.reviewerId == request.auth.uid ||
         resource.data.ownerId == request.auth.uid || 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
    }

    // Payments — users create their own, read their own. Admins can read/write all.
    match /payments/{docId} {
      allow read: if request.auth != null &&
        (resource.data.userId == request.auth.uid ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Escrow deposits — tenant or owner can read. Only admin can update status.
    match /escrowDeposits/{docId} {
      allow read: if request.auth != null &&
        (resource.data.tenantId == request.auth.uid ||
         resource.data.ownerId == request.auth.uid ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
      allow create: if request.auth != null && request.resource.data.tenantId == request.auth.uid;
      allow update: if request.auth != null &&
        (resource.data.tenantId == request.auth.uid ||
         resource.data.ownerId == request.auth.uid ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
    }

    // Notifications — users can only read/update their own
    match /notifications/{docId} {
      allow read, update: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null;
      allow delete: if request.auth != null &&
        (resource.data.userId == request.auth.uid ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
    }

    // Default: require auth for private data (requests, profiles, etc.)
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
