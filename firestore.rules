rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ══════════════════════════════════════════════════════════════════════════
    // HELPER FUNCTIONS
    // ══════════════════════════════════════════════════════════════════════════

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Pass the two values explicitly so the linter doesn't flag global variables
    // inside helper function bodies.
    // Usage: fieldUnchanged(request.resource.data.foo, resource.data.foo)
    function fieldUnchanged(incoming, existing) {
      return incoming == existing;
    }

    // ══════════════════════════════════════════════════════════════════════════
    // PLATFORM CONFIGURATION (Dynamic Fees, etc.)
    // ══════════════════════════════════════════════════════════════════════════
    match /platformConfig/{configId} {
      // Readable by anyone (since pricing needs to be shown publicly)
      allow read: if true; 
      
      // Only Admins can modify the current fee configuration
      allow update: if isAdmin();
      allow create: if isAdmin();
      allow delete: if false; // Prevent accidental deletion

      // Subcollection for audit history
      match /history/{historyId} {
        // Only admins can view the history logs
        allow read: if isAdmin();
        
        // Admins can create a history log when they update the config
        allow create: if isAdmin();
        allow update, delete: if false; // History is immutable once written
      }
    }

    // ══════════════════════════════════════════════════════════════════════════
    // USERS
    // ══════════════════════════════════════════════════════════════════════════
    match /users/{uid} {
      allow read: if true;

      allow create: if isOwner(uid)
                    // New accounts must NOT self-grant admin or premium roles.
                    && !('admin'               in request.resource.data)
                    && !('subscriptionTier'    in request.resource.data)
                    && !('listingEntitlement'  in request.resource.data)
                    && !('referralWallet'      in request.resource.data);

      allow update: if isAdmin()
                    || (isOwner(uid)
                        // Users cannot self-grant admin privileges or subscription tiers.
                        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
                          'admin', 'subscriptionTier', 'subscriptionPlan', 
                          'subscriptionExpiry', 'listingEntitlement', 'referralWallet'
                        ]));

      allow delete: if isAdmin();
    }

    // ══════════════════════════════════════════════════════════════════════════
    // PROPERTIES
    // ══════════════════════════════════════════════════════════════════════════
    match /properties/{propertyId} {
      // READ: Approved = public. Own properties (any status) visible to owner. Admin sees all.
      allow read: if resource.data.isApproved == true
                  || (isSignedIn() && resource.data.ownerId == request.auth.uid)
                  || isAdmin();

      // CREATE: Signed-in user creating their own listing.
      // Draft flow: status=draft or pending_payment.
      // Post-payment flow: status=Pending, isApproved=false.
      allow create: if isSignedIn()
                    && request.resource.data.ownerId == request.auth.uid
                    && request.resource.data.isApproved == false
                    && request.resource.data.status in ['draft', 'pending_payment', 'Pending'];

      // UPDATE: Owner can edit their own property content, but CANNOT:
      //   - Change ownerId
      //   - Self-approve (isApproved must stay false or match existing)
      //   - Change status to 'Available' (only admin can activate a listing)
      //   - Change isRejected (only admin can reject)
      allow update: if isAdmin()
                    || (isSignedIn()
                        && resource.data.ownerId == request.auth.uid
                        && request.resource.data.ownerId == resource.data.ownerId
                        // Cannot self-approve
                        && (request.resource.data.isApproved == false
                            || request.resource.data.isApproved == resource.data.isApproved)
                        // Cannot self-un-reject (only admin sets isRejected)
                        && (!("isRejected" in request.resource.data)
                            || request.resource.data.isRejected == resource.data.isRejected)
                        // Cannot elevate status to 'Available' — only admin approval does that
                        && request.resource.data.status in [
                            'draft', 'pending_payment', 'Pending',
                            'Available', 'Under Negotiation', 'Booked', 'Inactive'
                        ]
                        // Cannot set status=Available without admin approval
                        && !(request.resource.data.status == 'Available'
                             && request.resource.data.isApproved != true));

      // DELETE: Only owner can delete their own drafts/pending. Admins can delete anything.
      allow delete: if isAdmin()
                    || (isSignedIn()
                        && resource.data.ownerId == request.auth.uid
                        && resource.data.status in ['draft', 'pending_payment', 'Pending']);
    }

    // ══════════════════════════════════════════════════════════════════════════
    // PAYMENTS  — written exclusively by api/verify-payment.js (Admin SDK)
    // No client can ever write a payment record — period.
    // ══════════════════════════════════════════════════════════════════════════
    match /payments/{paymentId} {
      // Owner reads their own payments. Admin reads all.
      // api/verify-payment.js stores field 'uid' (not 'userId').
      allow read: if isOwner(resource.data.uid)
                  || isOwner(resource.data.userId)   // legacy fallback
                  || isAdmin();
      // ALL writes — create, update, delete — are backend-only via Admin SDK.
      allow write: if false;
    }

    // ══════════════════════════════════════════════════════════════════════════
    // UNCLAIMED TRANSACTIONS — sms-webhook writes, verify-payment claims.
    // Clients (including the logged-in user) NEVER get direct access.
    // This is the anti-replay-attack cornerstone: users submit a TxnID via
    // /api/verify-payment which runs on the server; the server fetches and
    // atomically claims the record inside a transaction. If clients could read
    // this collection they could enumerate available TxnIDs.
    // ══════════════════════════════════════════════════════════════════════════
    match /unclaimed_transactions/{txnId} {
      allow read:  if isAdmin();
      allow write: if false; // Admin SDK only (sms-webhook + verify-payment)
    }

    // ══════════════════════════════════════════════════════════════════════════
    // FLAGGED TRANSACTIONS — near-miss amount mismatch records
    // Written by verify-payment backend. Read by Admin only.
    // ══════════════════════════════════════════════════════════════════════════
    match /flagged_transactions/{txnId} {
      allow read:  if isAdmin();
      allow write: if false; // Admin SDK only
    }

    // ══════════════════════════════════════════════════════════════════════════
    // PAYMENT INTENTS — created by backend, read by owner.
    // ══════════════════════════════════════════════════════════════════════════
    match /paymentIntents/{intentId} {
      allow read: if isOwner(resource.data.uid) || isAdmin();
      allow write: if false; // Backend only
    }

    // ══════════════════════════════════════════════════════════════════════════
    // ESCROW DEPOSITS — written by verify-payment (Admin SDK).
    // Tenant and property owner can read their own escrow records.
    // Release confirmation (confirmedByTenant/confirmedByOwner) is handled
    // by the backend, not by direct client writes.
    // ══════════════════════════════════════════════════════════════════════════
    match /escrowDeposits/{escrowId} {
      allow read: if isSignedIn()
                  && (resource.data.tenantId == request.auth.uid
                      || resource.data.ownerId == request.auth.uid)
                  || isAdmin();
      allow write: if false; // Backend only
    }

    // ══════════════════════════════════════════════════════════════════════════
    // BOOKINGS — created by verify-payment (Admin SDK).
    // Tenant and owner can read. No client writes.
    // ══════════════════════════════════════════════════════════════════════════
    match /bookings/{bookingId} {
      allow read: if isSignedIn()
                  && (resource.data.tenantId == request.auth.uid
                      || resource.data.ownerId == request.auth.uid)
                  || isAdmin();
      allow write: if false; // Backend only
    }

    // ══════════════════════════════════════════════════════════════════════════
    // COMMISSIONS — referral commissions written by verify-payment.
    // Referrer can read their own. No client writes.
    // ══════════════════════════════════════════════════════════════════════════
    match /commissions/{commissionId} {
      allow read: if isOwner(resource.data.referrerId) || isAdmin();
      allow write: if false; // Backend only
    }

    // ══════════════════════════════════════════════════════════════════════════
    // KYC SUBMISSIONS — written by verify-kyc backend.
    // ══════════════════════════════════════════════════════════════════════════
    match /kycSubmissions/{submissionId} {
      allow read: if isOwner(resource.data.uid) || isAdmin();
      allow write: if false; // Backend only
    }

    // ══════════════════════════════════════════════════════════════════════════
    // WITHDRAWALS
    // ══════════════════════════════════════════════════════════════════════════
    match /withdrawals/{withdrawalId} {
      allow read: if isOwner(resource.data.uid) || isAdmin();
      allow write: if false; // Backend only
    }

    // ══════════════════════════════════════════════════════════════════════════
    // TENANT MOVE-INS
    // ══════════════════════════════════════════════════════════════════════════
    match /tenantMoveIns/{moveInId} {
      allow read: if isSignedIn()
                  && (resource.data.tenantId == request.auth.uid
                      || resource.data.ownerId == request.auth.uid)
                  || isAdmin();
      allow create: if isSignedIn()
                    && request.resource.data.tenantId == request.auth.uid;
      allow update: if isSignedIn()
                    && (resource.data.tenantId == request.auth.uid
                        || resource.data.ownerId == request.auth.uid)
                    || isAdmin();
      allow delete: if isAdmin();
    }

    // ══════════════════════════════════════════════════════════════════════════
    // VIEWING REQUESTS
    // ══════════════════════════════════════════════════════════════════════════
    match /viewing_requests/{requestId} {
      allow read: if isSignedIn()
                  && (resource.data.tenantId == request.auth.uid
                      || resource.data.ownerId == request.auth.uid)
                  || isAdmin();
      allow create: if isSignedIn()
                    && request.resource.data.tenantId == request.auth.uid;
      allow update: if isSignedIn()
                    && (resource.data.tenantId == request.auth.uid
                        || resource.data.ownerId == request.auth.uid)
                    || isAdmin();
      allow delete: if isAdmin();
    }

    // ══════════════════════════════════════════════════════════════════════════
    // CONVERSATIONS & MESSAGES
    // ══════════════════════════════════════════════════════════════════════════
    match /conversations/{conversationId} {
      allow read: if isSignedIn()
                  && request.auth.uid in resource.data.participants
                  || isAdmin();
      allow create: if isSignedIn()
                    && request.auth.uid in request.resource.data.participants
                    && request.resource.data.participants.size() == 2;
      allow update: if isSignedIn()
                    && request.auth.uid in resource.data.participants
                    || isAdmin();
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if isSignedIn()
                    && request.auth.uid in
                       get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants
                    || isAdmin();
        allow create: if isSignedIn()
                      && request.auth.uid in
                         get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants
                      && request.resource.data.senderId == request.auth.uid;
        allow update, delete: if isAdmin();
      }
    }

    // ══════════════════════════════════════════════════════════════════════════
    // NOTIFICATIONS
    // ══════════════════════════════════════════════════════════════════════════
    match /notifications/{notificationId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      // Allow user to mark their own notification as read (update only).
      allow update: if isOwner(resource.data.userId)
                    // Only allow toggling 'isRead'. Nothing else.
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']);
      // Allow any signed-in user to create a notification FOR another user
      // (e.g., tenant sends viewing request → notify the owner).
      // The recipient is resource.data.userId, not the sender.
      allow create: if isSignedIn()
                    && request.resource.data.userId != request.auth.uid;
      allow delete: if isAdmin();
    }

    // ══════════════════════════════════════════════════════════════════════════
    // ENQUIRIES
    // ══════════════════════════════════════════════════════════════════════════
    match /enquiries/{enquiryId} {
      allow read: if isSignedIn()
                  && (resource.data.tenantId == request.auth.uid
                      || resource.data.ownerId == request.auth.uid)
                  || isAdmin();
      allow create: if isSignedIn()
                    && request.resource.data.tenantId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // ══════════════════════════════════════════════════════════════════════════
    // REPORTS
    // ══════════════════════════════════════════════════════════════════════════
    match /reports/{reportId} {
      allow read: if isAdmin();
      allow create: if isSignedIn()
                    && request.resource.data.reporterId == request.auth.uid
                    // Cannot spam reports — max 1 field we actually need
                    && request.resource.data.keys().hasAll(['reporterId', 'propertyId', 'reason']);
      allow update, delete: if isAdmin();
    }

    // ══════════════════════════════════════════════════════════════════════════
    // PROPERTY REVIEWS
    // ══════════════════════════════════════════════════════════════════════════
    match /propertyReviews/{reviewId} {
      allow read: if true; // Public
      allow create: if isSignedIn()
                    && request.resource.data.reviewerId == request.auth.uid
                    // Rating must be 1–5
                    && request.resource.data.rating >= 1
                    && request.resource.data.rating <= 5;
      allow update: if isAdmin()
                    || (isSignedIn()
                        && resource.data.reviewerId == request.auth.uid
                        // Can only update rating and comment, not reviewerId or propertyId
                        && request.resource.data.reviewerId == resource.data.reviewerId
                        && request.resource.data.propertyId == resource.data.propertyId);
      allow delete: if isAdmin()
                    || (isSignedIn() && resource.data.reviewerId == request.auth.uid);
    }

    // ══════════════════════════════════════════════════════════════════════════
    // OWNER REVIEWS
    // ══════════════════════════════════════════════════════════════════════════
    match /ownerReviews/{reviewId} {
      allow read: if true; // Public
      allow create: if isSignedIn()
                    && request.resource.data.reviewerId == request.auth.uid
                    && request.resource.data.rating >= 1
                    && request.resource.data.rating <= 5;
      allow update: if isAdmin()
                    || (isSignedIn()
                        && resource.data.reviewerId == request.auth.uid
                        && request.resource.data.reviewerId == resource.data.reviewerId
                        && request.resource.data.ownerId == resource.data.ownerId);
      allow delete: if isAdmin()
                    || (isSignedIn() && resource.data.reviewerId == request.auth.uid);
    }

    // ══════════════════════════════════════════════════════════════════════════
    // ADMIN AUDIT LOGS — backend writes, admin reads only.
    // ══════════════════════════════════════════════════════════════════════════
    match /adminAuditLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false; // Backend only
    }

    // ══════════════════════════════════════════════════════════════════════════
    // REFERRAL DASHBOARD (read-only for owner)
    // ══════════════════════════════════════════════════════════════════════════
    match /referrals/{referralId} {
      allow read: if isOwner(resource.data.referrerId) || isAdmin();
      allow write: if false; // Backend only
    }

    // ══════════════════════════════════════════════════════════════════════════
    // CATCH-ALL: deny everything not explicitly matched above.
    // This prevents accidental exposure of any new collection you create.
    // ══════════════════════════════════════════════════════════════════════════
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
